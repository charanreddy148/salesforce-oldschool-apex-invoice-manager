<apex:page controller="InvoicePDFController" renderAs="pdf"
           applyHtmlTag="false" applyBodyTag="false"
           showHeader="false" sidebar="false" standardStylesheets="false">
    <html>
        <head>
            <style type="text/css">
                body { font-family: Arial, Helvetica, sans-serif; color: #222; margin: 40px; }
                .header { border-bottom: 3px solid #1b5297; padding-bottom: 10px; margin-bottom: 20px; }
                .company { font-size: 26px; font-weight: bold; color: #1b5297; }
                .doc-title { font-size: 18px; letter-spacing: 2px; color: #555; }
                table.meta { width: 100%; margin-bottom: 20px; }
                table.meta td { vertical-align: top; padding: 2px 0; }
                .label { color: #555; font-size: 11px; text-transform: uppercase; }
                table.lines { width: 100%; border-collapse: collapse; margin-top: 10px; }
                table.lines th { background: #1b5297; color: #fff; text-align: left; padding: 8px; font-size: 12px; }
                table.lines td { border-bottom: 1px solid #ddd; padding: 8px; font-size: 12px; }
                .num { text-align: right; }
                .total-row td { font-weight: bold; font-size: 14px; border-top: 2px solid #1b5297; }
                .notes { margin-top: 25px; font-size: 12px; color: #444; }
            </style>
        </head>
        <body>
            <div class="header">
                <div class="company">ABC Services</div>
                <div class="doc-title">INVOICE</div>
            </div>

            <apex:pageMessages />

            <apex:outputPanel rendered="{!NOT(ISNULL(invoice))}">
                <table class="meta">
                    <tr>
                        <td style="width:50%;">
                            <div class="label">Bill To</div>
                            <apex:outputText value="{!invoice.Account__r.Name}" /><br/>
                            <div class="label" style="margin-top:10px;">Status</div>
                            <apex:outputText value="{!invoice.Status__c}" />
                        </td>
                        <td style="width:50%; text-align:right;">
                            <div class="label">Invoice Number</div>
                            <apex:outputText value="{!invoice.Name}" /><br/>
                            <div class="label" style="margin-top:10px;">Issue Date</div>
                            <apex:outputText value="{0,date,MM/dd/yyyy}">
                                <apex:param value="{!invoice.Issue_Date__c}" />
                            </apex:outputText><br/>
                            <div class="label" style="margin-top:10px;">Due Date</div>
                            <apex:outputText value="{0,date,MM/dd/yyyy}">
                                <apex:param value="{!invoice.Due_Date__c}" />
                            </apex:outputText>
                        </td>
                    </tr>
                </table>

                <table class="lines">
                    <tr>
                        <th style="width:50%;">Description</th>
                        <th class="num" style="width:15%;">Qty</th>
                        <th class="num" style="width:17%;">Unit Price</th>
                        <th class="num" style="width:18%;">Amount</th>
                    </tr>
                    <apex:repeat value="{!lines}" var="line">
                        <tr>
                            <td><apex:outputText value="{!line.Product_Name__c}" /></td>
                            <td class="num">
                                <apex:outputText value="{0,number,#,##0.##}">
                                    <apex:param value="{!line.Quantity__c}" />
                                </apex:outputText>
                            </td>
                            <td class="num">
                                <apex:outputText value="{0,number,$#,##0.00}">
                                    <apex:param value="{!line.Unit_Price__c}" />
                                </apex:outputText>
                            </td>
                            <td class="num">
                                <apex:outputText value="{0,number,$#,##0.00}">
                                    <apex:param value="{!line.Amount__c}" />
                                </apex:outputText>
                            </td>
                        </tr>
                    </apex:repeat>
                    <tr class="total-row">
                        <td colspan="3" class="num">Grand Total</td>
                        <td class="num">
                            <apex:outputText value="{0,number,$#,##0.00}">
                                <apex:param value="{!grandTotal}" />
                            </apex:outputText>
                        </td>
                    </tr>
                </table>

                <apex:outputPanel rendered="{!NOT(ISBLANK(invoice.Notes__c))}">
                    <div class="notes">
                        <div class="label">Notes</div>
                        <apex:outputText value="{!invoice.Notes__c}" />
                    </div>
                </apex:outputPanel>
            </apex:outputPanel>
        </body>
    </html>
</apex:page>
